{
  "schema_version": 1,
  "quilt_loader": {
    "group": "com.example",
    "id": "examplemod",
    "version": "${version}",
    "metadata": {
      "name": "Example Mod",
      "description": "Пример мода на Quilt.",
      "contributors": {
        "Example": "Owner"
      }
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "init": [
        "com.example.examplemod.ExampleMod"
      ]
    },
    "depends": [
      {
        "id": "quilt_loader",
        "versions": ">=0.30.1"
      },
      {
        "id": "quilted_fabric_api",
        "versions": ">=7.7.0"
      },
      {
        "id": "minecraft",
        "versions": ">=1.20.1"
      }
    ]
  },
  "mixin": "examplemod.mixins.json"
}
